# Mirrored from .claude/settings.json permissions.allow.
#
# These Codex execpolicy rules allow matching commands to run outside the
# sandbox without prompting.
#
# Not directly represented as active prefix_rule entries:
# - Bash(.claude/:*) and Bash(~/.claude/:*): Claude path-scoped shell patterns,
#   not argv prefixes.
# - Bash(* --version) and Bash(* --help *): Codex prefix_rule supports exact
#   command-prefix matching, not wildcard command names.
#
# Non-Bash permissions such as Read(...) and mcp__... tools are intentionally
# excluded because Codex rules only control command execution.

# system
prefix_rule(
    pattern = ["which"],
    decision = "allow",
    justification = "Mirrors .claude/settings.json Bash allow list.",
)
prefix_rule(
    pattern = ["pwd"],
    decision = "allow",
    justification = "Mirrors .claude/settings.json Bash allow list.",
)
